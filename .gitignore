# ── Python / 工具缓存 ──
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/

# ── 依赖与打包产物 ──
vendor/
dist/
build/

# ── 本地运行数据（禁止提交）──
# data/ 是插件运行时数据目录，cache/ 是可重新生成的缓存
data/
cache/
store.db

# ── 密钥与本地配置（禁止提交）──
.env
.env.*
!.env.example
*.local.toml

# ── 系统 / 编辑器 ──
.DS_Store
Thumbs.db
# 保留 check --release 必需的 .vscode 脚手架，忽略其余（如 launch.json 可能含本地路径）
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
.idea/
